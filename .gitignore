.build/
.swiftpm/
*.app
.DS_Store
.hyalo-index
__pycache__/
*.part
.env
.env.*
!.env.example

# Signing material never enters the repository (kb: decisions/open-source-release)
*.p8
*.p12
*.pem
*.cer
*.mobileprovision
*.provisionprofile

# Release artefacts (scripts/make-dmg.sh)
/dist/
*.dmg

# Raw sources: copyrighted or large; kb/sources/manifest.json says how to fetch them.
# Our own research notes are kept.
/kb/raw/*
!/kb/raw/research/

# Generated by XcodeGen from project.yml
Almondbread.xcodeproj/
# Generated Info.plists (XcodeGen writes them from project.yml)
Apps/*/Info.plist

# Cargo build output
/target/

# Local agent tooling (hyalo init --claude), not part of the project
.claude/

# Rust core (kb: decisions/rust-core): cargo output, XCFramework and generated UniFFI bindings
# (`make rust` / scripts/build-rust-xcframework.sh recreate them)
/target/
/build/
/Sources/AlmondbreadCore/Generated/

# Review videos from `almondbread fly` (kb: synthesis/benchmarks, FL)
/review/
